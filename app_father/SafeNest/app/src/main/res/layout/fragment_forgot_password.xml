<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:fillViewport="true"
    tools:context=".fragments.ForgotPasswordFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- زر الرجوع -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/lemonada_bold"
            android:text="→ رجوع"
            android:textColor="@color/purple_accent"
            android:textSize="14sp"
            app:icon="@null" />

        <!-- الشعار -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="SafeNest Logo"
            android:scaleType="centerInside"
            android:src="@drawable/logo" />

        <!-- العنوان -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lemonada_bold"
            android:gravity="center"
            android:text="نسيت كلمة المرور؟"
            android:textColor="@color/purple_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- الوصف -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/lemonada_bold"
            android:gravity="center"
            android:text="أدخل بريدك الإلكتروني وسنرسل لك رمز التحقق لإعادة تعيين كلمة المرور"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp" />

        <!-- حقل البريد الإلكتروني -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="البريد الإلكتروني"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/purple_accent"
            app:hintTextColor="@color/purple_accent"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="@color/purple_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lemonada_bold"
                android:inputType="textEmailAddress"
                android:textDirection="rtl" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- مؤشر التحميل -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/purple_accent"
            android:visibility="gone" />

        <!-- زر الإرسال -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/lemonada_bold"
            android:text="إرسال رابط الإعادة"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="12dp" />

        <!-- تذكرت كلمة المرور؟ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lemonada_bold"
            android:gravity="center"
            android:text="تذكرت كلمة المرور؟ سجّل الدخول"
            android:textColor="@color/purple_accent"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
