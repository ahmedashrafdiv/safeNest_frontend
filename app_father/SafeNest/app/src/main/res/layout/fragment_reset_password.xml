<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:fillViewport="true"
    tools:context=".fragments.ResetPasswordFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- زر الرجوع -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/lemonada_bold"
            android:text="→ رجوع"
            android:textColor="@color/purple_accent"
            android:textSize="14sp"
            app:icon="@null" />

        <!-- الشعار -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="SafeNest Logo"
            android:scaleType="centerInside"
            android:src="@drawable/logo" />

        <!-- العنوان -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/lemonada_bold"
            android:gravity="center"
            android:text="إعادة تعيين كلمة المرور"
            android:textColor="@color/purple_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- الوصف -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/lemonada_bold"
            android:gravity="center"
            android:text="أدخل رمز التحقق الذي أُرسل إلى بريدك وكلمة المرور الجديدة"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp" />

        <!-- حقل رمز التحقق -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otpInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="رمز التحقق"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/purple_accent"
            app:hintTextColor="@color/purple_accent"
            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
            app:startIconTint="@color/purple_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otpEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lemonada_bold"
                android:inputType="number"
                android:maxLength="6"
                android:textDirection="rtl" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- حقل كلمة المرور الجديدة -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/newPasswordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="كلمة المرور الجديدة"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/purple_accent"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/purple_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lemonada_bold"
                android:inputType="textPassword"
                android:textDirection="rtl" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- حقل تأكيد كلمة المرور -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmPasswordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="تأكيد كلمة المرور"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/purple_accent"
            app:endIconMode="password_toggle"
            app:hintTextColor="@color/purple_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lemonada_bold"
                android:inputType="textPassword"
                android:textDirection="rtl" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- مؤشر التحميل -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/purple_accent"
            android:visibility="gone" />

        <!-- زر تغيير كلمة المرور -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/lemonada_bold"
            android:text="تغيير كلمة المرور"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="12dp" />

        <!-- تذكرت كلمة المرور؟ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lemonada_bold"
            android:gravity="center"
            android:text="تذكرت كلمة المرور؟ سجّل الدخول"
            android:textColor="@color/purple_accent"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
