<?xml version="1.0" encoding="utf-8"?>
<!-- Layngo email verification: one calm, accessible six-digit field and a single teal confirmation action. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory_surface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:paddingHorizontal="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:minHeight="600dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="العودة"
            android:fontFamily="sans"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="→"
            android:textColor="@color/navy_brand"
            android:textSize="24sp"
            app:backgroundTint="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/shieldLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Layngo"
            android:scaleType="centerInside"
            android:src="@drawable/layngo_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/verifyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/lemonada_bold"
            android:gravity="center"
            android:text="تحقق من بريدك\nالإلكتروني"
            android:textColor="@color/navy_brand"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shieldLogo" />

        <TextView
            android:id="@+id/verifyDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="أرسلنا رمزاً مكوناً من 6 أرقام إلى بريدك الإلكتروني."
            android:textColor="@color/gray_medium"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/verifyTitle" />

        <TextView
            android:id="@+id/emailDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="parent@example.com"
            android:textColor="@color/teal_brand"
            android:textDirection="ltr"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/verifyDescription" />

        <TextView
            android:id="@+id/otpCodeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans"
            android:text="رمز التحقق"
            android:textColor="@color/navy_brand"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emailDisplay" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otpCodeInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="13dp"
            app:boxCornerRadiusBottomStart="13dp"
            app:boxCornerRadiusTopEnd="13dp"
            app:boxCornerRadiusTopStart="13dp"
            app:boxStrokeColor="@color/gray_light"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otpCodeLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otpCodeEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:contentDescription="أدخل رمز التحقق المكون من ستة أرقام"
                android:fontFamily="sans"
                android:gravity="center"
                android:hint="000000"
                android:inputType="number"
                android:letterSpacing="0.14"
                android:maxLength="6"
                android:textColor="@color/navy_brand"
                android:textColorHint="@color/gray_medium"
                android:textDirection="ltr"
                android:textSize="18sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans"
            android:gravity="start"
            android:textColor="@color/red_warning"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otpCodeInputLayout" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/lemonada_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="تأكيد الرمز"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/teal_brand"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toTopOf="@id/resendContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/resendContainer"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/timerText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/resendText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="لم تستلم الرمز؟ "
                android:textColor="@color/gray_medium"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/resendBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="إعادة إرسال رمز التحقق"
                android:fontFamily="@font/lemonada_bold"
                android:gravity="center_vertical"
                android:text="إعادة الإرسال"
                android:textColor="@color/teal_brand"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/timerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:textColor="@color/gray_medium"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/teal_brand"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
