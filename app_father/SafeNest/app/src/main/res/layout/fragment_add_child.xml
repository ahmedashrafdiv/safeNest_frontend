<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header -->
        <ImageView
            android:id="@+id/headerShield"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="logo"
            android:src="@drawable/logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/lemonada_bold"
            android:text="اضف طفل"
            android:textColor="@color/purple_accent"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lemonada_bold"
            android:text="Safe Nest"
            android:textColor="@color/purple_primary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pageTitle" />

        <!-- Name field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="الاسم"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/purple_accent"
            app:hintTextColor="@color/purple_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandTitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/childName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lemonada_bold"
                android:inputType="textPersonName"
                android:textDirection="rtl" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Age field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ageInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="العمر"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/purple_accent"
            app:hintTextColor="@color/purple_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nameInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/childAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lemonada_bold"
                android:inputType="number"
                android:textDirection="rtl" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gender field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/genderInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="النوع ( ذكر / انثى )"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/purple_accent"
            app:hintTextColor="@color/purple_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ageInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/childGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lemonada_bold"
                android:inputType="text"
                android:textDirection="rtl" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Avatar Grid Title -->
        <TextView
            android:id="@+id/avatarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/lemonada_bold"
            android:text="الصوره"
            android:textColor="@color/purple_primary"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/genderInputLayout" />

        <!-- Avatar container using MaterialCardView -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatarContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/purple_primary"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/avatarTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- First row of avatars -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar1"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:contentDescription="avatar1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ch1"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar2"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:contentDescription="avatar2"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ch2"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar3"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="avatar3"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ch3"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                </LinearLayout>

                <!-- Second row of avatars -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar4"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:contentDescription="avatar4"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ch4"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar5"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:contentDescription="avatar5"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ch5"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar6"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:contentDescription="avatar6"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ch6"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/lemonada_bold"
            android:paddingHorizontal="48dp"
            android:text="تاكيد"
            android:textSize="16sp"
            app:backgroundTint="@color/purple_accent"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/avatarContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
