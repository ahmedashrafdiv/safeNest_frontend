<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/card_content_blur" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/gray_light" app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="خطوة اختيارية · Content Blur"
            android:textColor="@color/teal_brand"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/ibm_plex_sans_arabic"
            android:text="فعّل تغطية الوسائط الحساسة"
            android:textColor="@color/navy_brand"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/ibm_plex_sans_arabic"
            android:text="تحتاج هذه الحماية إلى خدمة إمكانية وصول مستقلة. تتم المعالجة على الجهاز، وتبقى الشاشة مغطاة حتى تصبح نتيجة التحليل SAFE."
            android:textColor="@color/gray_medium"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_content_blur_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ibm_plex_sans_arabic"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enable_content_blur"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="تفعيل خدمة Content Blur"
            android:textColor="@color/white"
            app:backgroundTint="@color/teal_brand"
            app:cornerRadius="16dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

