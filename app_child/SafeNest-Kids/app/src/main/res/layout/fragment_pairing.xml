<?xml version="1.0" encoding="utf-8"?>
<!-- Layngo Kids OTP: friendly RTL copy with left-to-right numeric cells. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/daily_usage_ivory"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:text="Layngo للأطفال"
            android:textColor="@color/navy_brand"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/mint_surface"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/teal_brand"
                android:textDirection="ltr"
                android:textSize="28sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="أدخل رمز ولي الأمر"
            android:textColor="@color/navy_brand"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="ستجد الرمز على هاتف الوالد."
            android:textColor="@color/gray_medium"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/otp_cells"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/otp_digit_1"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:background="@drawable/otp_cell_background"
                android:gravity="center"
                android:inputType="number"
                android:padding="0dp"
                android:textColor="@color/navy_brand"
                android:textDirection="ltr"
                android:textSize="21sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/otp_digit_2"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/otp_cell_background"
                android:gravity="center"
                android:inputType="number"
                android:padding="0dp"
                android:textColor="@color/navy_brand"
                android:textDirection="ltr"
                android:textSize="21sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/otp_digit_3"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/otp_cell_background"
                android:gravity="center"
                android:inputType="number"
                android:padding="0dp"
                android:textColor="@color/navy_brand"
                android:textDirection="ltr"
                android:textSize="21sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/otp_digit_4"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/otp_cell_background"
                android:gravity="center"
                android:inputType="number"
                android:padding="0dp"
                android:textColor="@color/navy_brand"
                android:textDirection="ltr"
                android:textSize="21sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/otp_digit_5"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/otp_cell_background"
                android:gravity="center"
                android:inputType="number"
                android:padding="0dp"
                android:textColor="@color/navy_brand"
                android:textDirection="ltr"
                android:textSize="21sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/otp_digit_6"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/otp_cell_background"
                android:gravity="center"
                android:inputType="number"
                android:padding="0dp"
                android:textColor="@color/navy_brand"
                android:textDirection="ltr"
                android:textSize="21sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="الرمز مؤقت ويُستخدم مرة واحدة."
            android:textColor="@color/gray_medium"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:textColor="@color/coral_action"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_link"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:fontFamily="sans"
            android:text="تأكيد الرمز"
            android:textColor="@color/white"
            app:backgroundTint="@color/teal_brand"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_code"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans"
            android:text="إدخال رمز جديد"
            android:textColor="@color/navy_brand"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fontFamily="sans"
            android:text="العودة"
            android:textColor="@color/navy_brand" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/teal_brand"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
